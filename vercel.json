{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "framework": "vite",
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api/:path*"
        },
        {
            "source": "/join/:code",
            "destination": "/index.html"
        },
        {
            "source": "/((?!api|assets|favicon|.*\\..*).*)",
            "destination": "/index.html"
        }
    ]
}