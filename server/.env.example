# Twilio Configuration
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here

# Use ONE of these (Messaging Service OR Phone Number):
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OR
TWILIO_PHONE_NUMBER=+1234567890

# Supabase Configuration (optional - uses in-memory if not set)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Server Configuration
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Security Settings
# ALLOW_TEST_BYPASS: Set to 'true' ONLY in development/test environments
# Enables test account login (phone: 5550001234, code: 123456)
# WARNING: NEVER set this to 'true' in production!
ALLOW_TEST_BYPASS=true

# ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins
# For production, set to your actual domain(s)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting (optional - defaults shown)
# OTP send: max attempts per phone per window (ms)
# RATE_LIMIT_OTP_SEND=3
# RATE_LIMIT_OTP_SEND_WINDOW=3600000

# OTP verify: max attempts per phone per window (ms)
# RATE_LIMIT_OTP_VERIFY=5
# RATE_LIMIT_OTP_VERIFY_WINDOW=600000

# Invite SMS: max invites per user per window (ms)
# RATE_LIMIT_INVITE_SMS=5
# RATE_LIMIT_INVITE_SMS_WINDOW=3600000
